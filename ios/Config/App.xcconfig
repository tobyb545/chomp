// Base settings for the app target. Secrets live in Secrets.xcconfig (gitignored).
// Leave values empty to run fully offline (solo + bots, no purchases).
SUPABASE_URL =
SUPABASE_ANON_KEY =
REVENUECAT_API_KEY =
STRAVA_CLIENT_ID =
// The Chomp website (GitHub Pages), written https:/$()/host/path with no trailing slash.
// When set, invite and club links point at its /invite/ and /club/ pages, which work in
// any messaging app. Empty: links use the chomp:// scheme.
CHOMP_WEB_URL =
// Prebuilt street tiles on Cloudflare R2 (tools/tiles), written https:/$()/host with no
// trailing slash. Empty: tiles come from the server's cache and Overpass only.
CHOMP_TILES_URL =
#include? "Secrets.xcconfig"
